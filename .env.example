DEBUG=False
SECRET_KEY=gere-uma-chave-longa-e-aleatoria-e-unica
SECRET_SALT=gere-outro-segredo-longo-e-independente

ALLOWED_HOSTS=seuservidor.com.br
CSRF_TRUSTED_ORIGINS=https://seuservidor.com.br

DB_NAME=nome_do_banco_de_dados
DB_USER=usuario_do_banco
DB_PASSWORD=gere-uma-senha-forte-e-exclusiva
DB_HOST=host-do-banco-de-dados
DB_PORT=5432

VECTOR_DB_ENGINE=django.db.backends.postgresql
VECTOR_DB_NAME=nome-do-banco-de-dados-vetor
VECTOR_DB_USER=usuario-do-banco-vetor
VECTOR_DB_PASSWORD=senha-forte-e-exclusiva-para-vetor
VECTOR_DB_HOST=db_vector
VECTOR_DB_PORT=5432

DB_CONN_MAX_AGE=60
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Active Directory via LDAP. Pode usar ldap://host:389 ou ldaps://host:636.
LDAP_SERVER=dc01.empresa.local:389
LDAP_DOMAIN=empresa.local
LDAP_BASE_DN=DC=empresa,DC=local
LDAP_BIND_USER=svc-enps
LDAP_BIND_PASSWORD=

SESSION_MAX_AGE=28800

# --- Banco de Talentos --------------------------------------------------------
# LLM (OpenAI) que interpreta o currículo e sugere o cargo.
OPENAI_API_KEY=sua-chave-da-openai-aqui
CURRICULO_LLM_MODEL=gpt-4o
# Embeddings: endpoint compatível com /v1/embeddings (a OpenAI oferece embeddings).
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=sua-chave-da-openai-aqui
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Currículos (PDF) ficam fora de /media/ para não serem públicos.
PRIVATE_MEDIA_ROOT=/app/private_media
CURRICULO_MAX_MB=5
CURRICULO_MAX_ARQUIVOS=5
